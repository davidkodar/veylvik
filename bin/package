#!/usr/bin/env bash
# Build a local Arch package without installing it or publishing a release.
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
version="$(sed -n 's/^pkgver=//p' "$root/pkgbuild/PKGBUILD")"
workspace_version="$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$root/Cargo.toml")"
if [[ "$version" != "$workspace_version" || ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf '%s\n' 'Package and workspace versions must match.' >&2
    exit 1
fi
for command in cargo makepkg tar sha256sum desktop-file-validate git; do
    command -v "$command" > /dev/null || { printf 'Missing build tool: %s\n' "$command" >&2; exit 1; }
done
author_name="$(git -C "$root" config user.name)"
author_email="$(git -C "$root" config user.email)"
if [[ -z "$author_name" || -z "$author_email" ]]; then
    printf '%s\n' 'Configure the package author through git user.name and user.email.' >&2
    exit 1
fi
stage="$(mktemp -d "${TMPDIR:-/tmp}/veylvik-package.XXXXXXXX")"
trap 'rm -rf -- "$stage"' EXIT
mkdir -p "$root/target/packages"
tar -C "$root" -czf "$stage/veylvik-$version.tar.gz" \
    --transform="s,^,veylvik-$version/," \
    Cargo.toml Cargo.lock rust-toolchain.toml crates bin pkgbuild README.md
checksum="$(sha256sum "$stage/veylvik-$version.tar.gz")"
checksum="${checksum%% *}"
sed "s/sha256sums=('SKIP')/sha256sums=('$checksum')/" \
    "$root/pkgbuild/PKGBUILD" > "$stage/PKGBUILD"
cd "$stage"
PACKAGER="$author_name <$author_email>" CARGO_TARGET_DIR="$root/target" PKGDEST="$root/target/packages" \
    makepkg --force --cleanbuild "$@"
printf 'Package output: %s\n' "$root/target/packages"
