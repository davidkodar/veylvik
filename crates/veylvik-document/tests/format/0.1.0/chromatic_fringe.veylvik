    "be212ad7-a943-4976-b1e1-9f52fd2229e2": {
      "id": "be212ad7-a943-4976-b1e1-9f52fd2229e2",
      "inputs": {
        "image": "cd716e3d-c8f4-4d8e-8ffd-353c392c4398"
      },
      "label": "Fringe",
      "operation": {
        "code": "// slider amount 0 20 8\n// slider falloff 0.5 4 2\n\n// What a real lens does to colour away from the middle of the frame: red and blue\n// focused a little apart, so bright edges toward the corners show a red fringe on one\n// side and a blue one on the other. Amount is how many pixels apart they are at the\n// frame's corner (in a 1920-wide frame; in proportion in others); falloff is how fast\n// it grows from nothing in the middle (2: with the square of the distance).\nfn shade(at: vec2<f32>) -> vec4<f32> {\n    let middle = size * 0.5;\n    let from_middle = (at - middle) / length(middle);\n    let shift = from_middle * pow(length(from_middle), u.falloff - 1.0) * u.amount * size.x / 1920.0;\n    let red = image(at + shift);\n    let green = image(at);\n    let blue = image(at - shift);\n    return vec4<f32>(red.r, green.g, blue.b, max(green.a, max(red.a, blue.a)));\n}\n",
        "follow": null,
        "p1": {
          "kind": "constant",
          "value": 8.0
        },
        "p10": {
          "kind": "constant",
          "value": 0.0
        },
        "p11": {
          "kind": "constant",
          "value": 0.0
        },
        "p12": {
          "kind": "constant",
          "value": 0.0
        },
        "p13": {
          "kind": "constant",
          "value": 0.0
        },
        "p14": {
          "kind": "constant",
          "value": 0.0
        },
        "p15": {
          "kind": "constant",
          "value": 0.0
        },
        "p16": {
          "kind": "constant",
          "value": 0.0
        },
